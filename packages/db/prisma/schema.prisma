generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Chain {
  solana
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  walletAddress String?        @unique
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  checks        CheckHistory[]
  sessions      Session[]
  creditLots    CreditLot[]
  creditLedger  CreditLedger[]
}

model AuthNonce {
  id        String    @id @default(cuid())
  address   String
  nonceHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address, expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CheckHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  address   String
  chain     Chain    @default(solana)
  score     Int
  level     String
  summary   String
  reasons   Json
  signals   Json
  sources   Json
  raw       Json?
  createdAt DateTime @default(now())

  @@index([address, chain])
  @@index([userId, createdAt])
}

enum CampaignTrigger {
  first_login
  code
  manual
}

enum LotSource {
  promo
  purchase
}

enum LedgerType {
  promo_grant
  purchase
  spend
  refund
  admin_adjust
  expire
}

model Campaign {
  id              String          @id @default(cuid())
  key             String          @unique
  name            String
  credits         Int
  trigger         CampaignTrigger
  isActive        Boolean         @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  expiresInDays   Int?
  fixedExpiresAt  DateTime?
  maxClaims       Int?
  claimCount      Int             @default(0)
  code            String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lots            CreditLot[]
}

model CreditLot {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     LotSource
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount     Int
  remaining  Int
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  @@unique([userId, campaignId])
  @@index([userId, expiresAt])
}

model CreditLedger {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      LedgerType
  delta     Int
  lotId     String?
  refId     String?
  reason    String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([refId])
}

model GuestUsage {
  id     String @id @default(cuid())
  ipHash String
  day    String
  count  Int    @default(0)

  @@unique([ipHash, day])
}