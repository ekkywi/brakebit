generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Chain {
  solana
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  checks    CheckHistory[]
}

model CheckHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  address   String
  chain     Chain    @default(solana)
  score     Int
  level     String
  summary   String
  reasons   Json
  signals   Json
  sources   Json
  raw       Json?
  createdAt DateTime @default(now())

  @@index([address, chain])
  @@index([userId, createdAt])
}
