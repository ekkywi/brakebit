# --- App / API ---
API_PORT=3001
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Database (Neon). Optional for anon checks; required for history, cache, auth ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Solana RPC (live checks). Prefer Helius over public Labs RPC ---
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
# SOLSCAN_API_KEY=
# BIRDEYE_API_KEY=

# --- Rate limit (POST /checks, per IP, in-memory) ---
CHECKS_RATE_LIMIT=10
CHECKS_RATE_TTL_MS=60000

# --- Check cache (reuse CheckHistory; 0 = always live) ---
CHECK_CACHE_TTL_MS=300000

# --- Auth (wallet SIWS + httpOnly session cookie) ---
# Must match the Domain line in the sign-in message (host[:port] users see).
AUTH_DOMAIN="localhost:3000"
SESSION_TTL_MS=604800000
AUTH_NONCE_TTL_MS=600000
# Leave empty locally. Production: ".brakebit.com" so the web app's middleware can read the cookie.
SESSION_COOKIE_DOMAIN=

# Number of proxies in front of the API. Local: 0. Render: 1. Needed for real client IPs (guest quota, throttling).
TRUST_PROXY_HOPS=0

# Production values (set in Render and Vercel, not here):
#   API (Render):  CORS_ORIGIN="https://brakebit.com"  AUTH_DOMAIN="brakebit.com"  TRUST_PROXY_HOPS=1
#                  SESSION_COOKIE_DOMAIN=".brakebit.com"
#   Web (Vercel):  NEXT_PUBLIC_API_URL="https://api.brakebit.com"

# --- Guest quota (no login): live checks per hashed IP per UTC day ---
# Generate with: openssl rand -hex 32
GUEST_IP_SALT=YOUR_OPENSSL_RAND_HEX_32_RESULT
GUEST_DAILY_FREE_CHECKS=1