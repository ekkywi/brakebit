# Shared / API
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
API_PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Solana (live checks). Prefer Helius / QuickNode / Alchemy over the public Labs RPC.
# Helius also powers DAS getAsset (token name/symbol/logo on reports).
# SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_KEY"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Optional mega-cap top-holder fallbacks (not required for most mints):
# SOLSCAN_API_KEY="your_solscan_pro_key"
# BIRDEYE_API_KEY="your_birdeye_key"

# Rate limit for POST /checks (per IP, in-memory)
CHECKS_RATE_LIMIT=10
CHECKS_RATE_TTL_MS=60000

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
